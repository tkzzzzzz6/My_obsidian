// 输出数组中逆序对的数量

// 1.采用枚举的方法
procedure CountInversePairs(A,n)   
    Sum <- 0
    for i <- 1 to n - 1 do 
        for j <- i + 1 to n do
            if A[i] > A[j] then
            Sum <- Sum + 1
        end
    end
    return Sum
end procedure

// 2.采用分治法(归并求解)
procedure MergeCount(A,left,right)
    A'[left..right] <- A[left..right]
    S3 <- 0
    i <- left,j <- mid + 1,k <- 0
    while i <= mid and j <= right do
        if A'[i] <= A'[j] then
            A[left + k] <- A'[i]
            k <- k + 1
            i <- i + 1
        end
        else
            A[left + k] <- A'[j]
            k <- k + 1
            j <- j + 1
            S3 <- S3 + (mid - i + 1) // 统计逆序对数量
        end
    end
    if i <= mid then 
        A[k..right] <- A'[i..mid]
    end
    else
        A[k..right] <- A'[j..right]
    end
    return S3,A[left..right]
end procedure

procedure CountInver(A,left,right)
    if left >= right then
        return A[left..right]
    end
    mid <- floor((left + right) / 2)
    S1 <- CountInver(A,left,mid)
    S2 <- CountInver(A,mid + 1,right)
    S3,A[left..right] <- MergeCount(A,left,right)
    S <- S1 + S2 + S3
    return S,A[left..right]